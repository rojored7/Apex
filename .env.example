# APEX · variables de entorno. Copiar a .env y cambiar todos los "cambiar-esto".
# Nunca se versiona .env. Settings (api) usa extra="forbid": una variable que no
# conozca el api debe estar en NON_API_ENV_VARS (las de Compose y las del CLI).

# === Base de datos (las POSTGRES_* las lee el contenedor db; el api solo DATABASE_URL) ===
# Usuario de PostgreSQL.
POSTGRES_USER=apex
# Contraseña de PostgreSQL. Debe coincidir con la de DATABASE_URL.
POSTGRES_PASSWORD=cambiar-esto
# Nombre de la base.
POSTGRES_DB=apex
# URL async del api hacia el servicio db de Compose (misma contraseña que arriba).
DATABASE_URL=postgresql+asyncpg://apex:cambiar-esto@db:5432/apex
# URL de la base de prueba efímera (db_test de compose.dev.yml) vista desde el host; pytest falla sin ella.
# Siempre 127.0.0.1, no localhost: db_test escucha solo en IPv4 y en Windows el intento por ::1 tarda 2 s en fallar.
TEST_DATABASE_URL=postgresql+asyncpg://apex:apex-test@127.0.0.1:5433/apex_test

# === Llaves (viven en el volumen keys, nunca en el repo ni en la imagen) ===
# Llave privada Ed25519 para firmar JWT.
JWT_PRIVATE_KEY_PATH=/run/apex/keys/jwt_ed25519.pem
# Llave pública; opcional, se deriva de la privada si falta.
JWT_PUBLIC_KEY_PATH=/run/apex/keys/jwt_ed25519.pub
# Proveedor de llaves: local en v0.1, openbao desde v0.2.
CRYPTO_PROVIDER=local
# KEK local de 32 bytes, modo 600. Perderla es perder los datos cifrados.
CRYPTO_LOCAL_KEK_PATH=/run/apex/keys/kek.bin

# === Aplicación ===
# dev | production. En production /docs y /openapi.json quedan apagados.
ENV=dev
# Zona horaria para mostrar fechas; el "hoy" de negocio lo fija today_bogota() en core/clock.py.
TZ_DISPLAY=America/Bogota
# Carpeta de archivos subidos (volumen uploads).
UPLOADS_DIR=/data/uploads
# Orígenes permitidos por CORS, lista JSON.
CORS_ORIGINS=["http://localhost"]
# Nivel de log (JSON a stdout).
LOG_LEVEL=INFO
# IPs de proxies confiables para X-Forwarded-For, separadas por coma (vacío: ninguno).
TRUSTED_PROXIES=
# true solo con TLS (v0.3); la cookie del refresh lleva Secure.
COOKIE_SECURE=false
# URL base del front para los enlaces de activación y recuperación.
FRONT_BASE_URL=http://localhost
# Versión que publica /health; la imagen la fija con el SHA de git.
APP_VERSION=dev

# === Primer admin (un solo uso, US-041; bórralas del .env después de crear el admin) ===
# Correo del primer administrador.
ADMIN_EMAIL=admin@ejemplo.local
# Contraseña inicial del primer administrador (mínimo 12 caracteres).
ADMIN_INITIAL_PASSWORD=cambiar-esto

# === Puertos publicados en el host (solo Compose; cámbialos si otro proyecto los ocupa) ===
# Nginx (front y proxy del api).
WEB_PORT=80
# api en desarrollo (compose.dev.yml).
API_PORT=8000
# PostgreSQL en desarrollo.
DB_PORT=5432
# PostgreSQL de prueba (db_test). Debe coincidir con TEST_DATABASE_URL.
DB_TEST_PORT=5433
