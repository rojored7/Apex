# APEX · variables de entorno. Copiar a .env y cambiar todos los "cambiar-esto".
# Nunca se versiona .env. Settings (api) usa extra="forbid": una variable que no
# conozca el api debe estar en NON_API_ENV_VARS (las de Compose y las del CLI).

# === Base de datos (las POSTGRES_* las lee el contenedor db; el api solo DATABASE_URL) ===
# Usuario de PostgreSQL.
POSTGRES_USER=apex
# Contraseña de PostgreSQL. Debe coincidir con la de DATABASE_URL.
POSTGRES_PASSWORD=cambiar-esto
# Nombre de la base.
POSTGRES_DB=apex
# URL async del api hacia el servicio db de Compose (misma contraseña que arriba).
DATABASE_URL=postgresql+asyncpg://apex:cambiar-esto@db:5432/apex
# URL de la base de prueba efímera (db_test de compose.dev.yml) vista desde el host; pytest falla sin ella.
# Siempre 127.0.0.1, no localhost: db_test escucha solo en IPv4 y en Windows el intento por ::1 tarda 2 s en fallar.
TEST_DATABASE_URL=postgresql+asyncpg://apex:apex-test@127.0.0.1:5433/apex_test

# === Llaves (viven en el volumen keys, nunca en el repo ni en la imagen) ===
# Llave privada Ed25519 para firmar JWT.
JWT_PRIVATE_KEY_PATH=/run/apex/keys/jwt_ed25519.pem
# Llave pública; opcional, se deriva de la privada si falta.
JWT_PUBLIC_KEY_PATH=/run/apex/keys/jwt_ed25519.pub
# Proveedor de llaves: local en v0.1, openbao desde v0.2.
CRYPTO_PROVIDER=local
# KEK local de 32 bytes, modo 600. Perderla es perder los datos cifrados.
CRYPTO_LOCAL_KEK_PATH=/run/apex/keys/kek.bin
# Llave Ed25519 de firma del bus (semilla de 32 bytes); también la crea init-keys.
CRYPTO_LOCAL_SIGNING_KEY_PATH=/run/apex/keys/sign-ed25519.key

# === Aplicación ===
# dev | production. En production /docs y /openapi.json quedan apagados.
ENV=dev
# Zona horaria para mostrar fechas; el "hoy" de negocio lo fija today_bogota() en core/clock.py.
TZ_DISPLAY=America/Bogota
# Carpeta de archivos subidos (volumen uploads).
UPLOADS_DIR=/data/uploads
# Orígenes exactos permitidos por CORS, separados por coma (también se acepta una lista JSON);
# solo si el front se sirve desde otro origen; nunca *. Vacío = sin CORS (Nginx sirve front y
# api en el mismo origen).
CORS_ORIGINS=
# Nivel de log (JSON a stdout).
LOG_LEVEL=INFO
# Proxies cuya X-Forwarded-For se acepta (redes CIDR o IPs separadas por coma): solo la IP de
# Nginx, el contenedor web, fija en infra/compose.yml (subred 172.30.0.0/24, web en .10; M-1).
# Vacío = ninguno: todo intento cuenta contra la IP del proxy (más restrictivo, nunca más abierto).
TRUSTED_PROXIES=172.30.0.10/32
# Claves (bucket, IP) que guarda el limitador en memoria antes de expulsar la más antigua.
RATE_LIMIT_MAX_KEYS=10000
# Riesgo aceptado P7 (LAN sin TLS, v0.1): con ENV=production el api no arranca con
# COOKIE_SECURE=false salvo que esta variable sea true; ponerla en true es aceptar que la
# contraseña y la cookie del refresh viajan en claro por la red local (M-9; docs/RUNBOOK.md).
ALLOW_INSECURE_COOKIE=false
# true solo con TLS (v0.3); la cookie del refresh lleva Secure.
COOKIE_SECURE=false
# URL base del front para los enlaces de activación y recuperación. Su puerto debe coincidir
# con WEB_PORT (con WEB_PORT=8180: http://localhost:8180); el 80 se omite.
FRONT_BASE_URL=http://localhost
# Versión que publica /health; la imagen la fija con el SHA de git.
APP_VERSION=dev

# Contraseñas (US-032): argon2id. Valores por defecto de argon2-cffi; producción no acepta menos.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=4
# Política N-10: longitud mínima; además se rechaza una lista corta de contraseñas comunes.
PASSWORD_MIN_LENGTH=12

# Sesiones (US-033): access JWT de 15 minutos (tolerancia 30 s) y refresh de 7 días.
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_DAYS=7
JWT_LEEWAY_S=30
# Gracia del reuso de refresh (M-2): un refresh ya rotado que vuelve antes de estos segundos da
# 401 sin cerrar las demás sesiones (recarga o dos pestañas); después, es reuso y se revoca todo.
REFRESH_REUSE_GRACE_S=10
# Tope absoluto de una familia de refresh (L-4): pasados estos días desde el login hay que
# volver a iniciar sesión aunque la cookie siga rotando.
REFRESH_ABSOLUTE_TTL_DAYS=30
# Orígenes aceptados en login, refresh y logout (Origin, Referer o Sec-Fetch-Site; M-1),
# separados por coma, nunca *. Vacío = el origen de FRONT_BASE_URL. En local con Vite:
# http://localhost:8180,http://localhost:5173
AUTH_ALLOWED_ORIGINS=
# Piso en milisegundos de toda respuesta 401 de login (M-6; N-7 de la revisión V10): el p99 de
# argon2 más commit bajo contención (docs/RUNBOOK.md). Iguala un correo existente y uno inexistente.
LOGIN_MIN_DURATION_MS=150

# === Límites de intentos (S2-B2; E5 del plan del Sprint 2; docs/RUNBOOK.md) ===
# Por IP (IPv4 exacta, IPv6 por /64): intentos de login por ventana de LOGIN_IP_WINDOW_S segundos.
LOGIN_IP_LIMIT=5
LOGIN_IP_WINDOW_S=60
# Por cuenta: fallos de un mismo correo desde una misma red (/24 o /64) por ventana; el último
# admin activo queda exento (S2-D10, H-4).
LOGIN_ACCOUNT_LIMIT=10
LOGIN_ACCOUNT_WINDOW_S=900
# Tope global de fallos de un mismo correo desde cualquier red: solo desacelera un ataque repartido.
LOGIN_ACCOUNT_GLOBAL_LIMIT=100
LOGIN_ACCOUNT_GLOBAL_WINDOW_S=3600
# Fallos consecutivos que bloquean la cuenta (locked_at; se libera con cli unlock-user).
LOGIN_LOCK_AFTER=20
# Por IP y por minuto en las demás rutas de sesión (L-12).
REFRESH_IP_LIMIT=60
RESET_IP_LIMIT=10
FORGOT_IP_LIMIT=5
LOGOUT_IP_LIMIT=30

# === Tiempos de espera de la base (S3-D43, H-3; docs/RUNBOOK.md sección 9) ===
# lock_timeout, statement_timeout e idle_in_transaction_session_timeout de cada conexión del api,
# el worker y el CLI, en milisegundos. Una espera agotada responde 503 busy con Retry-After: 1.
# 0 desactiva; solo el CLI con --db-timeouts off (comandos largos). No los baje a 0 en el api.
DB_LOCK_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_IN_TX_TIMEOUT_MS=60000

# === Topes por usuario autenticado (S3-D76; E10 y E15; docs/RUNBOOK.md) ===
# Intentos por usuario y por ventana; el siguiente da 429 con Retry-After.
# USER_WRITE alimenta memberships-write y payments-write; USER_ADMIN_WRITE, admin-write.
USER_WRITE_LIMIT_PER_MIN=30
USER_ADMIN_WRITE_LIMIT_PER_MIN=30
# Altas de socios (members-write).
USER_MEMBERS_WRITE_LIMIT_PER_MIN=60
# Búsquedas libres sobre datos de personas (members-search).
USER_SEARCH_LIMIT_PER_MIN=60
# Fichas de socio abiertas (members-detail).
USER_DETAIL_LIMIT_PER_MIN=120
# Revelado de datos cifrados (members-reveal, -hour y -day).
USER_REVEAL_LIMIT_PER_MIN=30
USER_REVEAL_LIMIT_PER_HOUR=200
USER_REVEAL_LIMIT_PER_DAY=600

# === Primer admin (US-041): NO va aquí. ADMIN_EMAIL y ADMIN_INITIAL_PASSWORD se escriben en
# .env.seed (ver .env.seed.example), que solo lee el servicio tools con SeedSettings; api,
# worker y db nunca las reciben (M-8).

# === Puertos publicados en el host (solo Compose; cámbialos si otro proyecto los ocupa) ===
# Nginx (front y proxy del api).
WEB_PORT=80
# api en desarrollo (compose.dev.yml).
API_PORT=8000
# PostgreSQL en desarrollo.
DB_PORT=5432
# PostgreSQL de prueba (db_test). Debe coincidir con TEST_DATABASE_URL.
DB_TEST_PORT=5433

# === Perfil E2E de límites (E5 del plan del Sprint 2) ===
# Los valores de la sección de límites de arriba son los de producción.
# Solo durante la validación E2E (V4) el .env de CI y el local suben los topes, por ejemplo:
#   LOGIN_IP_LIMIT=1000  LOGIN_ACCOUNT_LIMIT=1000  LOGIN_LOCK_AFTER=1000
#   REFRESH_IP_LIMIT=1000  RESET_IP_LIMIT=1000  FORGOT_IP_LIMIT=1000  LOGOUT_IP_LIMIT=1000
# Tras editar .env: `docker compose ... up -d api` (no `restart`: env_file se lee al crear el
# contenedor) y restaurar los valores al terminar. El smoke del sexto intento (B2) corre antes,
# con el perfil de producción. El borde de Nginx (limit_req de 60r/m con burst 30 en
# /api/v1/auth/, infra/nginx/snippets/auth-zone.conf dentro de la imagen) solo se sube en el
# perfil E2E apilando infra/compose.e2e.yml al levantar web (V4 del Sprint 2), y se vuelve a
# producción con `up -d web` sin ese archivo.
