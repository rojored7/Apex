# APEX · variables de operación (S4B-D56, S4B-D79). Copiar a .env.ops (modo 600, nunca se
# versiona) y cambiar todos los "cambiar-esto". Ninguna la lee Settings del api: todas están
# en NON_API_ENV_VARS. En el servidor Compose se invoca con los dos archivos:
#   docker compose --env-file .env --env-file .env.ops -f infra/compose.yml ...
# En W0-1 aquí viven solo las variables NUEVAS de operación; POSTGRES_*, DATABASE_URL,
# TEST_DATABASE_URL y los puertos siguen en .env.example hasta S4B-W0-3, que parte los
# servicios y los mueve aquí. En desarrollo, .env es la suma de los dos ejemplos.

# === Respaldo cifrado (servicio backup; docs/RUNBOOK.md §12) ===
# Días que se conservan los juegos apex-* (entero de 3 a 365). Los pre-deploy y pre-restore no se borran solos.
BACKUP_KEEP_DAYS=14
# Hora del respaldo (cron de cinco campos, hora de Bogotá).
BACKUP_CRON=0 2 * * *
# Destinatario público age (age1...). Vacío = el servicio backup queda inerte y lo dice en el log.
BACKUP_AGE_RECIPIENT=
# Destinatario público de la identidad de verificación (segundo -r de age); vacío = sin verificación.
BACKUP_AGE_VERIFY_RECIPIENT=
# Destino remoto opcional: apex:<cubo>/<ruta>. Vacío = el respaldo vive solo en el volumen backups
# (el mismo disco que la base: P3, no es un respaldo fuera de la máquina).
BACKUP_RCLONE_REMOTE=

# === rclone: remoto "apex" por variables (credencial SIN permiso de borrado; ver el RUNBOOK) ===
RCLONE_CONFIG_APEX_TYPE=s3
RCLONE_CONFIG_APEX_PROVIDER=
RCLONE_CONFIG_APEX_ENDPOINT=
RCLONE_CONFIG_APEX_ACCESS_KEY_ID=
RCLONE_CONFIG_APEX_SECRET_ACCESS_KEY=

# === Firma del manifiesto (minisign, S4B-D57) ===
# Llave pública minisign (línea RW...), para restore.sh y la documentación.
BACKUP_SIGN_PUBKEY=
# Ruta en el anfitrión del archivo de la llave privada de firma (600, uid 10001); solo se monta en backup.
BACKUP_SIGN_KEY_FILE=
# Ruta en el anfitrión de la identidad age de verificación (600, uid 10001); solo con infra/compose.verify.yml.
BACKUP_VERIFY_IDENTITY_FILE=

# === Despliegue ===
# Segundos que deploy.sh espera db y migrations en ok.
DEPLOY_HEALTH_TIMEOUT=120

# === Roles de base de datos (S4B-W0-3; contraseñas de 24 caracteres o más y distintas entre sí) ===
APEX_API_DB_PASSWORD=cambiar-esto
APEX_WORKER_DB_PASSWORD=cambiar-esto
APEX_BACKUP_DB_PASSWORD=cambiar-esto

# === Red (la subred puede cambiarse para un ensayo en la misma máquina, S4B-D13) ===
APEX_SUBNET=172.30.0.0/24
APEX_IP_RANGE=172.30.0.128/25
APEX_WEB_IP=172.30.0.10
