# APEX · variables de operación (S4B-D56, S4B-D79). Copiar a .env.ops (modo 600, nunca se
# versiona) y cambiar todos los "cambiar-esto". Ninguna la lee Settings del api: todas están
# en NON_API_ENV_VARS. En el servidor Compose se invoca con los dos archivos:
#   docker compose --env-file .env --env-file .env.ops -f infra/compose.yml ...
# Aquí vive todo lo que NO es de Settings, más DATABASE_URL (Settings la define, pero Compose se la
# da a cada servicio por su cuenta, S4B-D56). En desarrollo, .env es la suma de los dos ejemplos.

# === Base de datos (las POSTGRES_* las lee el contenedor db; migrate, dbsetup y tools usan al propietario) ===
# Usuario propietario de PostgreSQL (nunca entra a api ni worker).
POSTGRES_USER=apex
# Contraseña del propietario: genérela con `openssl rand -hex 24` (solo letras y números: va dentro de DATABASE_URL).
POSTGRES_PASSWORD=cambiar-esto
# Nombre de la base.
POSTGRES_DB=apex
# URL async del propietario hacia el servicio db de Compose (misma contraseña que arriba). La usan
# tools y migrate; api y worker reciben la suya con su rol (apex_api, apex_worker).
DATABASE_URL=postgresql+asyncpg://apex:cambiar-esto@db:5432/apex
# URL de la base de prueba efímera (db_test de compose.dev.yml) vista desde el host; pytest falla sin ella.
# Siempre 127.0.0.1, no localhost: db_test escucha solo en IPv4 y en Windows el intento por ::1 tarda 2 s en fallar.
TEST_DATABASE_URL=postgresql+asyncpg://apex:apex-test@127.0.0.1:5433/apex_test

# === Puertos publicados en el host (solo Compose; cámbialos si otro proyecto los ocupa) ===
# Nginx (front y proxy del api).
WEB_PORT=80
# api en desarrollo (compose.dev.yml).
API_PORT=8000
# PostgreSQL en desarrollo.
DB_PORT=5432
# PostgreSQL de prueba (db_test). Debe coincidir con TEST_DATABASE_URL.
DB_TEST_PORT=5433

# === Respaldo cifrado (servicio backup; docs/RUNBOOK.md §12) ===
# Días que se conservan los juegos apex-* (entero de 3 a 365). Los pre-deploy y pre-restore no se borran solos.
BACKUP_KEEP_DAYS=14
# Volumen de respaldos (campo de Settings; el worker lo monta solo lectura): ahí está latest.json
# que lee backup_check (S4B-D25).
BACKUP_DIR=/data/backups
# Hora del respaldo (cron de cinco campos, hora de Bogotá).
BACKUP_CRON=0 2 * * *
# Destinatario público age (age1...). Vacío = el servicio backup queda inerte y lo dice en el log.
BACKUP_AGE_RECIPIENT=
# Destinatario público de la identidad de verificación (segundo -r de age); vacío = sin verificación.
BACKUP_AGE_VERIFY_RECIPIENT=
# Destino remoto opcional: apex:<cubo>/<ruta>. Vacío = el respaldo vive solo en el volumen backups
# (el mismo disco que la base: P3, no es un respaldo fuera de la máquina).
BACKUP_RCLONE_REMOTE=

# === rclone: remoto "apex" por variables (credencial SIN permiso de borrado; ver el RUNBOOK) ===
RCLONE_CONFIG_APEX_TYPE=s3
RCLONE_CONFIG_APEX_PROVIDER=
RCLONE_CONFIG_APEX_ENDPOINT=
RCLONE_CONFIG_APEX_ACCESS_KEY_ID=
RCLONE_CONFIG_APEX_SECRET_ACCESS_KEY=

# === Firma del manifiesto (minisign, S4B-D57) ===
# Llave pública minisign (línea RW...), para restore.sh y la documentación.
BACKUP_SIGN_PUBKEY=
# Ruta en el anfitrión del archivo de la llave privada de firma (600, uid 10001); solo se monta en backup.
BACKUP_SIGN_KEY_FILE=
# Ruta en el anfitrión de la identidad age de verificación (600, uid 10001); solo con infra/compose.verify.yml.
BACKUP_VERIFY_IDENTITY_FILE=

# === Despliegue ===
# Segundos que deploy.sh espera db y migrations en ok.
DEPLOY_HEALTH_TIMEOUT=120

# === Roles de base de datos (S4B-W0-3; distintas entre sí, de 24 caracteres o más y solo [A-Za-z0-9._~-]) ===
# Genere cada una con `openssl rand -hex 24`: dbsetup rechaza cualquier otro alfabeto (van dentro de una URL).
APEX_API_DB_PASSWORD=cambiar-esto
APEX_WORKER_DB_PASSWORD=cambiar-esto
APEX_BACKUP_DB_PASSWORD=cambiar-esto

# === Carpeta de .env y .env.seed (solo ensayos en la misma máquina; vacío = la raíz del repo) ===
# Relativa a infra/. Ejemplo del ensayo: APEX_ENV_DIR=../docs/scratch/ensayo (los env_file de api, worker
# y tools se leen de ahí, no del .env de desarrollo).
# APEX_ENV_DIR=..

# === Red (la subred puede cambiarse para un ensayo en la misma máquina, S4B-D13) ===
APEX_SUBNET=172.30.0.0/24
APEX_IP_RANGE=172.30.0.128/25
APEX_WEB_IP=172.30.0.10
