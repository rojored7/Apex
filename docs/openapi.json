              "degraded"
            ],
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "db",
          "version"
        ],
        "title": "HealthOut",
        "type": "object"
      }
    }
  },
