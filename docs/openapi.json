          "name": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "nit": {
            "anyOf": [
              {
                "maxLength": 15,
                "pattern": "^\\d+(-\\d)?$",
                "type": "string"
              },
