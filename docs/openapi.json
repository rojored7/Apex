        "additionalProperties": false,
        "description": "Datos del gimnasio (US-055, N-18). `name` sin default: el `\"APEX\"` vive en los defaults.",
        "properties": {
          "address": {
            "anyOf": [
              {
                "maxLength": 120,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Address"
          },
          "city": {
            "anyOf": [
              {
                "maxLength": 60,
                "type": "string"
              },
              {
                "type": "null"
              }
