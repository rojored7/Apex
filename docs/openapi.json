{
  "components": {
    "schemas": {
      "ErrorBody": {
        "example": {
          "code": "member_duplicate",
          "existing_id": "11111111-2222-3333-4444-555555555555",
          "field": "document",
          "message": "Ya existe un socio con este documento"
