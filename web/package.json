{
  "name": "apex-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:catalog": "tsc --noEmit && vite build --mode catalog",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "e2e": "playwright test",
    "gen:api": "openapi-typescript ../docs/openapi.json -o src/core/api/types.ts",
    "generate:api": "npm run gen:api",
    "licenses": "license-checker --production --excludePrivatePackages --onlyAllow \"MIT;BSD-2-Clause;BSD-3-Clause;Apache-2.0;ISC;0BSD;OFL-1.1;MIT-0;BlueOak-1.0.0;CC0-1.0;Unlicense\" --summary"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-router": "^7.18.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "license-checker": "^25.0.1",
    "openapi-typescript": "7.13.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.5",
    "vitest": "^3.2.7",
    "vitest-axe": "^0.1.0"
  }
